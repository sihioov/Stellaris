# Stellaris 환경변수 예시
# 이 파일을 .env로 복사 후 값 입력: cp .env.example .env

# GitHub 연동 (Canopus agenda Issue/Project metadata, PR finalization)
GITHUB_TOKEN=your_github_token_here
GITHUB_OWNER=sihioov
GITHUB_REPO=Stellaris
# GitHub Project v2 node ID or owner/number lookup metadata.
# GITHUB_PROJECT_ID is the GraphQL ProjectV2 node ID, not a URL.
GITHUB_PROJECT_ID=
GITHUB_PROJECT_URL=
GITHUB_PROJECT_OWNER_KIND=
GITHUB_PROJECT_OWNER=
GITHUB_PROJECT_NUMBER=
GITHUB_PROJECT_STATUS_FIELD_ID=
GITHUB_PROJECT_STATUS_FIELD_NAME=Status
GITHUB_PROJECT_STATUS_OPTION_ID=
GITHUB_PROJECT_STATUS_OPTION_NAME=

# GitHub/Project safety gates. Defaults should remain no HTTP/no live mutation.
CANOPUS_GITHUB_PROJECT_MODE=dry-run-offline
CANOPUS_ENABLE_GITHUB=0
CANOPUS_ALLOW_GITHUB_MUTATION=0
CANOPUS_ENABLE_LIVE_MUTATIONS=0
CANOPUS_ALLOW_GITHUB_PROJECT_MUTATION=0
CANOPUS_ALLOW_GITHUB_REGISTRATION_MUTATION=0
CANOPUS_ALLOW_GITHUB_REPO_CREATE=0
CANOPUS_ALLOW_GITHUB_PR_MUTATION=0
CANOPUS_ALLOW_GITHUB_MERGE=0
CANOPUS_ALLOW_DEPLOY=0
CANOPUS_DEPLOY_ADAPTER=
CANOPUS_DEPLOY_ENVIRONMENT=
CANOPUS_DEPLOY_COMMAND=
CANOPUS_COMMAND=canopus

# Discord 알림 (작업 완료/승인 요청 알림)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here

# 태스크 파일 경로: Discord Bot, TON618, Laniakea가 같은 파일을 사용해야 합니다.
TASKS_JSON_PATH=tasks.json

# laniakea 워커 설정
LANIAKEA_SOURCE=file
LANIAKEA_FILE_PATH=tasks.json

# Canopus local command-runtime dry-run. Mock remains safe default if CANOPUS_AGENT_RUNTIME is unset.
# Use a deterministic command for local P0 smoke runs; it runs once per Canopus role stage.
CANOPUS_AGENT_RUNTIME=command
CANOPUS_AGENT_COMMAND=python3 -c "import os; print('canopus dry-run stage=' + os.environ.get('CANOPUS_ROLE', 'unknown'))"

# canopus watch/finalizer 명령용. start-pipeline.ps1 wires these to <repo>/.canopus.
CANOPUS_REPO=.
CANOPUS_STATE=.canopus

# hubble 스캐너용
REPO_PATH=.

# Rust 로그 레벨 (info, debug, warn, error)
RUST_LOG=info
