DISCORD_BOT_TOKEN=your_bot_token_here
# Set TASKS_JSON_PATH to the same absolute tasks.json watched by TON618/Laniakea.
# If unset, the bot falls back to TASKS_DIR/tasks-<category_id>.json.
TASKS_JSON_PATH=
TASKS_DIR=.
ALLOWED_USER_IDS=
CANOPUS_STATE_PATH=

# GitHub agenda metadata copied into !run payloads/status output.
GITHUB_OWNER=
GITHUB_REPO=
# GitHub Project v2 metadata copied into task payloads. Leave blank for local-only work.
# GITHUB_PROJECT_ID is a GraphQL ProjectV2 node ID; GITHUB_PROJECT_URL may be a
# canonical https://github.com/users/<owner>/projects/<number> or
# https://github.com/orgs/<owner>/projects/<number> URL.
GITHUB_PROJECT_ID=
GITHUB_PROJECT_URL=
GITHUB_PROJECT_OWNER_KIND=
GITHUB_PROJECT_OWNER=
GITHUB_PROJECT_NUMBER=
GITHUB_PROJECT_STATUS_FIELD_ID=
GITHUB_PROJECT_STATUS_FIELD_NAME=Status
GITHUB_PROJECT_STATUS_OPTION_ID=
GITHUB_PROJECT_STATUS_OPTION_NAME=
CANOPUS_GITHUB_PROJECT_MODE=dry-run-offline

# Optional direct-answer backend for !ask.
# The question is sent to stdin and STELLARIS_ASK_PROMPT.
# Example:
# ASK_COMMAND=python3 -c 'import sys; print("Answer:", sys.stdin.read())'
ASK_COMMAND=
ASK_TIMEOUT_SECONDS=30
ASK_MAX_OUTPUT_CHARS=1800
